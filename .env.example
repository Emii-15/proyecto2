# Supabase Project Settings > API. Never expose the service-role key in the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# A long, random secret used only by the server to sign the app session tokens.
JWT_SECRET=replace_with_a_long_random_secret
